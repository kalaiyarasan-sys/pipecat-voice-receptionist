# Everything runs locally. No API keys needed.

# --- LLM (Ollama) ---
# Start Ollama (`ollama serve`) and pull a tool-calling model, e.g. `ollama pull qwen3:4b`
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3-4b-local
# Disable Qwen3 "thinking" for lower latency
LLM_NO_THINK=true

# --- Speech-to-text (faster-whisper) ---
# tiny | base | small | medium | large-v3-turbo  (multilingual; "small" handles Tamil)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Leave empty to auto-detect language, or force: en / ta
WHISPER_LANGUAGE=

# --- Text-to-speech (Piper) ---
# Voice is auto-downloaded once into PIPER_VOICES_DIR. List: https://huggingface.co/rhasspy/piper-voices
PIPER_VOICE=en_US-lessac-medium
PIPER_VOICES_DIR=models/piper
